  "private": true,
  "engines": {
    "node": "^22"
  },
  "dependencies": {
    "babel-preset-expo": "~57.0.0",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "uuidv7": "^1.2.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "5.0.1",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "5.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/web-dev-notice.mjs && npm run web:preview",
    "lint": "expo lint",
    "lint:ratchet": "node scripts/check-lint-ratchet.mjs",
    "lint:record": "node scripts/check-lint-ratchet.mjs --record",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "verify": "npm run typecheck && npm run test:coverage && npm run lint:ratchet",
    "web:export": "expo export -p web --clear",
    "web:preview": "npm run web:export && node scripts/serve-web-export.mjs dist",
    "bundle:check": "node scripts/check-web-budget.mjs dist",
    "verify:full": "npm run verify && npm run web:export && npm run bundle:check",
    "audit:unused": "npx --yes knip@6.32.0",
    "audit:duplication": "npx --yes jscpd@5.0.16 src",
    "db:generate": "drizzle-kit generate"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "decode-uri-component": "^0.5.0",
    "esbuild": "^0.25.12"
  }
}
