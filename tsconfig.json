{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Named rather than left to the automatic `@types/*` scan: Helix measured a
    // clean `npm ci` whose hoisting left `node:*` unregistered and 206 errors on
    // an unchanged tree. The major matches `.nvmrc`, so the gate cannot accept
    // an API the runtime does not have.
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Deno's, with remote imports; a test imports what it runs of them. Expo's
  // generated types exist only where Expo has run, so a runner never saw them:
  // the first loosened the local gate, the second tightened it. Expo CLI writes
  // both back into `include` (`type-generation/tsconfig.js`) and never reads
  // `exclude`, so they are left out here (2026-10-09).
  "exclude": ["node_modules", "dist", "coverage", "supabase/functions", "expo-env.d.ts", ".expo"]
}
